#!/bin/sh
# desk-screenshot [--geometry "X,Y WxH" | --file PNG] -- a picture of the
# screen, or of that part of it (the window in front: Alt+Print), taken with
# grim into Pictures/Screenshots -- or one taken already (Print's camera
# cuts its own from the screens as they were when it was pressed), moved
# there; the picture put on the clipboard (wl-copy), and a letter in the
# post box saying where it went (notify-send). Print, Ctrl+Print and
# Alt+Print in DEsk run this.
set -u
geom=""
from=""
if [ "${1:-}" = --geometry ] && [ -n "${2:-}" ]; then
	geom=$2
elif [ "${1:-}" = --file ] && [ -n "${2:-}" ]; then
	from=$2
fi
case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
ja*) title="スクリーンショット"; saved="保存しました"; nogrim="grim が入っていないので撮れません（sudo apt install grim）" ;;
*) title="Screenshot"; saved="Saved"; nogrim="grim is not installed, so nothing could be taken" ;;
esac
tell() {
	command -v notify-send >/dev/null 2>&1 && notify-send -a "$title" "$@"
}
if [ -z "$from" ] && ! command -v grim >/dev/null 2>&1; then
	tell "$title" "$nogrim"
	exit 1
fi
dir=$(xdg-user-dir PICTURES 2>/dev/null || true)
if [ -z "$dir" ] || [ "$dir" = "$HOME" ]; then
	dir="$HOME/Pictures"
fi
dir="$dir/Screenshots"
mkdir -p "$dir" || exit 1
file="$dir/$(date '+%Y-%m-%d %H.%M.%S').png"
if [ -n "$from" ]; then
	mv -f -- "$from" "$file" || exit 1
elif [ -n "$geom" ]; then
	grim -g "$geom" "$file" || exit 1
else
	grim "$file" || exit 1
fi
if command -v wl-copy >/dev/null 2>&1; then
	wl-copy --type image/png < "$file" &
fi
tell -i "$file" "$title" "$saved: $file"
