// consolesfx.lib -- (2026-11-14): what the Control Panel is made of, as sound. A face of black-
// painted steel in a walnut case; brass bezels; glass caps lit from inside; a bat lever on a spring; a
// knob on a ball detent; a lock; a transformer humming behind it all.
import("desksfx.lib");

// a set of resonances, struck by what comes in: F the pitches, T how long each rings (t60), G how loud;
// fs moves them all up or down, ts makes them ring longer or shorter
bank(F, T, G, fs, ts) = _ <: par(i, ba.count(F), pm.modeFilter(ba.take(i + 1, F) * fs, ba.take(i + 1, T) * ts,
	ba.take(i + 1, G))) :> _;

// the face: painted steel in a wooden case, so it rings, but not for long
panel(fs) = bank((310, 520, 790, 1130, 1580, 2210, 3050, 4200), (0.09, 0.07, 0.055, 0.045, 0.035, 0.025, 0.018, 0.012),
	(0.7, 1.0, 0.8, 0.7, 0.5, 0.4, 0.3, 0.2), fs, 1.0) : *(0.002);
// the walnut lid the four big caps sit in
lidwood(fs) = bank((175, 320, 505, 740, 1060, 1480, 2050), (0.07, 0.055, 0.04, 0.03, 0.022, 0.016, 0.011),
	(1.0, 0.8, 0.6, 0.45, 0.32, 0.2, 0.12), fs, 1.0) : *(0.002);
// a glass cap, domed
glass(fs) = bank((2350, 3920, 5650, 7700, 9900), (0.035, 0.025, 0.018, 0.012, 0.008), (1.0, 0.7, 0.5, 0.3, 0.18),
	fs, 1.0) : *(0.002);
// a brass ring or bezel
brass(fs) = bank((3150, 4720, 6930, 9250), (0.09, 0.06, 0.04, 0.025), (1.0, 0.7, 0.45, 0.25), fs, 1.0) : *(0.002);
// a chromed bat lever
bat(fs) = bank((1850, 3350, 5700, 8100), (0.025, 0.018, 0.012, 0.007), (1.0, 0.8, 0.5, 0.2), fs, 1.0) : *(0.002);

// a snap-action switch going over: a sliver of bright noise and its spring ringing twice, briefly
snap(t) = (n(7) : fi.highpass(2, 3000.0) : fi.lowpass(2, 11000.0) : *(t : ar(0.0002, 0.0012)))
	+ (t : bank((4300, 6150), (0.006, 0.004), (1.0, 0.6), 1.0, 1.0) : *(0.004));

// mains hum through a rectifier: 100 Hz and its harmonics, thinning upward; f sags as it dies
humtone(f) = sum(k, 6, os.osc(f * (k + 1)) / (1.0 + k * 1.3)) * 0.4;
